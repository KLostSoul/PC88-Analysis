<!DOCTYPE html>

<html lang="ko">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>PC-88 게임 분석을 위한 기초 강좌 3부 — 플로피·μPD765·D88·Kanji ROM</title>
<style>
:root{--bg:#f5f7fb;--paper:#fff;--ink:#172033;--muted:#5b6578;--line:#d8deea;--accent:#3157d5;--accent2:#2342a3;--soft:#eef3ff;--ok:#13795b;--warn:#9a6700;--bad:#b42318;--code:#111827;--codeink:#e5e7eb;--shadow:0 12px 30px rgba(23,32,51,.08)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI","Noto Sans KR","Malgun Gothic",sans-serif;line-height:1.75}a{color:var(--accent2)}
header{background:linear-gradient(135deg,#172554,#2746b8);color:#fff;padding:54px 20px 46px}.header-inner{max-width:1080px;margin:auto}.eyebrow{font-size:.9rem;letter-spacing:.08em;font-weight:800;opacity:.82}h1{font-size:clamp(2rem,5vw,3.4rem);line-height:1.13;margin:.35rem 0 .8rem}.lead{max-width:930px;font-size:1.08rem;color:#e3e9ff;margin:0}.hero-badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.hero-badge{padding:6px 10px;border:1px solid rgba(255,255,255,.3);border-radius:999px;font-size:.86rem;font-weight:800;background:rgba(255,255,255,.08)}
.wrap{max-width:1080px;margin:0 auto;padding:24px 20px 80px}nav.toc{background:var(--paper);border:1px solid var(--line);box-shadow:var(--shadow);border-radius:18px;padding:20px 22px;margin-top:-24px;position:relative}nav.toc strong{display:block;margin-bottom:8px;font-size:1.15rem}nav.toc ol{margin:0;padding-left:1.4rem;columns:2;column-gap:2rem}nav.toc li{break-inside:avoid;margin:.25rem 0}
section{background:var(--paper);border:1px solid var(--line);border-radius:20px;padding:32px;margin-top:24px;box-shadow:0 6px 18px rgba(23,32,51,.04)}section.section-break{background:linear-gradient(135deg,#eef3ff,#f8faff);border:2px solid #c7d3f6}h2{font-size:1.75rem;margin:0 0 8px;line-height:1.3}h3{font-size:1.22rem;margin:1.9rem 0 .65rem}h4{font-size:1.05rem;margin:1.3rem 0 .4rem}p{margin:.55rem 0 1rem}.kicker{font-weight:800;color:var(--accent);font-size:.92rem}.term{font-weight:800;color:#183c98}.muted{color:var(--muted)}
.note,.warning,.beginner,.why,.misconception{padding:14px 16px;border-radius:12px;margin:16px 0}.note{background:#f4f7fb;border:1px solid #dce4ef}.warning{background:#fff8e6;border:1px solid #f4d78c}.beginner{background:#f8fbff;border:1px solid #c9d8ff;border-left:5px solid #3157d5}.why{background:#fffdf3;border:1px solid #eadb9a;border-left:5px solid #c58a00}.misconception{background:#fff5f5;border:1px solid #f0c7c7;border-left:5px solid #c73b3b}.beginner b:first-child{color:#183c98}
code,kbd{font-family:ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace}.inline-code{background:#eef1f6;border:1px solid #d9dfe9;border-radius:5px;padding:.06rem .32rem;font-family:ui-monospace,SFMono-Regular,Consolas,monospace}pre{background:var(--code);color:var(--codeink);padding:16px;border-radius:13px;overflow:auto;line-height:1.58;tab-size:4}
table{width:100%;border-collapse:collapse;margin:14px 0 20px;font-size:.96rem}th,td{border:1px solid var(--line);padding:9px 10px;text-align:center}th{background:#f3f6fb}td.left,th.left{text-align:left}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.card{border:1px solid var(--line);border-radius:14px;padding:16px;background:#fbfcfe}.card h4{margin-top:0}.flow{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;margin:18px 0}.flow .box{border:2px solid #9fb0e9;background:#f5f7ff;border-radius:12px;padding:13px 18px;text-align:center;min-width:125px;font-weight:800}.arrow{font-size:1.6rem;color:#6b7ab6;font-weight:900}.formula{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-weight:900;background:#eef3ff;border:1px solid #cad6f8;border-radius:10px;padding:12px 14px;text-align:center;margin:12px 0}
.lab{border:1px solid #cbd7f2;background:#f8faff;border-radius:14px;padding:16px;margin:16px 0}.lab h4{margin:0 0 8px;color:#2444a8}.lab label{font-weight:800;margin-right:6px}.lab input,.lab select{font:inherit;border:1px solid #a8b3c6;border-radius:8px;background:#fff;padding:7px 9px;min-width:80px}.controls,.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:10px 0}.btn{border:1px solid #a8b3c6;background:#fff;color:var(--ink);padding:8px 12px;border-radius:9px;font-weight:700;cursor:pointer}.btn.primary,.btn.active{background:#3157d5;color:#fff;border-color:#3157d5}.btn:disabled{opacity:.5;cursor:not-allowed}.readout{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;background:#f2f5fa;border-radius:10px;padding:11px 13px;margin-top:10px;white-space:pre-wrap}
.svg-wrap{border:1px solid var(--line);background:#fff;border-radius:14px;padding:12px;overflow:auto}.svg-wrap svg{display:block;width:100%;height:auto;min-width:600px}.svg-title{font-weight:900;fill:#243d91}.svg-label{font-weight:800;fill:#334155}.svg-small{font-size:12px;fill:#5b6578}.svg-code{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;fill:#172033}
.rotation-board{display:grid;grid-template-columns:minmax(430px,1.4fr) minmax(260px,.8fr);gap:18px;align-items:start}.sector-ring path{fill:#e8edf7;stroke:#fff;stroke-width:3;transition:fill .25s,filter .25s}.sector-ring path.under-head{fill:#3157d5;filter:drop-shadow(0 0 5px rgba(49,87,213,.45))}.rotor{transform-origin:230px 190px;transition:transform .55s ease}.fixed-head{fill:#172033}.head-arrow{stroke:#172033;stroke-width:4;marker-end:url(#arrowHead)}.sector-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;margin:12px 0}.sector-card{border:1px solid #b8c4de;border-radius:9px;background:#fff;padding:10px 5px;text-align:center;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-weight:800}.sector-card.hot{background:#3157d5;color:#fff;border-color:#3157d5}.sector-card.past{opacity:.45}.fixed-head-marker{text-align:center;font-weight:900;color:#172033}.fixed-head-marker:before{content:'▲';display:block;color:#172033}
.seek-static{border:1px solid #cbd7f2;background:#fff;border-radius:14px;padding:16px;margin:16px 0}.seek-axis{margin:16px 0 8px}.seek-axis-title{display:flex;justify-content:space-between;font-weight:800;color:#526079;margin-bottom:6px}.seek-track-row{display:grid;grid-template-columns:repeat(6,minmax(80px,1fr));gap:6px;min-width:560px}.seek-track-box{position:relative;border:1px solid #b8c4de;border-radius:9px;background:#fff;padding:13px 6px 34px;text-align:center;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-weight:800}.seek-track-box.start{background:#fff;border:2px solid #3157d5}.seek-track-box.target{background:#fff;border:2px solid #d5a312}.seek-track-box.arrived{background:#fff;border:2px solid #13795b}.seek-head-chip{position:absolute;left:50%;bottom:5px;transform:translateX(-50%);background:#172033;color:#fff;border-radius:6px;padding:3px 8px;font:800 11px/1.3 system-ui,-apple-system,"Segoe UI","Noto Sans KR",sans-serif;white-space:nowrap}.seek-target-chip{position:absolute;left:50%;bottom:6px;transform:translateX(-50%);color:#8b6200;font:800 11px/1.3 system-ui,-apple-system,"Segoe UI","Noto Sans KR",sans-serif;white-space:nowrap}.seek-move{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:center;margin:14px 0}.seek-state{border:1px solid var(--line);border-radius:12px;background:#fff;padding:13px}.seek-state b{display:block;color:#2444a8;margin-bottom:4px}.seek-arrow{font-size:2rem;color:#3157d5;font-weight:900;text-align:center}
.track-anatomy{display:grid;gap:8px}.anatomy-layer{display:none}.anatomy-layer.visible{display:grid}.basic-sector{grid-template-columns:1fr 2.5fr;gap:8px}.basic-sector>div,.detail-track>div{border:1px solid var(--line);border-radius:9px;padding:11px;text-align:center;font-weight:800;background:#fff}.basic-sector .id{background:#eef3ff}.basic-sector .data{background:#ecfdf5}.detail-track{grid-template-columns:repeat(8,minmax(95px,1fr));gap:5px;overflow:auto}.detail-track .gap{background:#fff8e6}.detail-track .id{background:#eef3ff}.detail-track .data{background:#ecfdf5}
.fdc-stage{border-left:5px solid #9aa8c4;background:#f6f8fb;padding:10px 12px;border-radius:8px;margin:7px 0}.fdc-stage.active{border-left-color:#3157d5;background:#eef3ff}.fdc-stage.done{border-left-color:#13795b;background:#ecfdf5}
.d88-map{display:grid;grid-template-columns:120px 1fr;gap:6px;align-items:stretch;margin:14px 0}.d88-offset{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;text-align:right;padding:12px 8px;color:#526079}.d88-block{border:2px solid #b3bfd9;border-radius:10px;padding:12px;background:#fff;cursor:pointer}.d88-block.header{background:#dbe7ff}.d88-block.tableb{background:#ede9fe}.d88-block.sech{background:#fff0bf}.d88-block.payload{background:#d9f7ea}.d88-block.hot{outline:3px solid #3157d5;outline-offset:2px}.pointer-line{display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:#f8faff;border:1px solid #cbd7f2;padding:10px 12px;border-radius:10px;margin:10px 0}.pointer-arrow{font-size:1.5rem;color:#3157d5;font-weight:900}
.walker-track{display:grid;grid-template-columns:repeat(8,1fr);gap:5px;overflow:auto}.walk-sec{min-width:78px;border:1px solid #b8c4de;border-radius:9px;background:#fff;padding:9px;text-align:center;font-family:ui-monospace,SFMono-Regular,Consolas,monospace}.walk-sec.hot{background:#3157d5;color:#fff}.advanced-box{display:none}.advanced-box.visible{display:block}
.dual-rep{display:grid;grid-template-columns:1fr 1fr;gap:16px}.repbox{border:1px solid var(--line);border-radius:12px;padding:13px;background:#fff}.payload-chip,.meta-chip{display:inline-block;padding:7px 9px;border-radius:7px;margin:3px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;cursor:default}.payload-chip{background:#d9f7ea;border:1px solid #79c9a9}.meta-chip{background:#fff0bf;border:1px solid #e3bf55}
.glyph-editor{display:grid;grid-template-columns:minmax(300px,390px) 1fr;gap:20px;align-items:start}.glyph-grid{display:grid;grid-template-columns:repeat(16,1fr);border:2px solid #334155;aspect-ratio:1/1;background:#fff;max-width:390px}.pixel{border:1px solid #e0e5ee;background:#fff;cursor:pointer;padding:0;min-width:0}.pixel.on{background:#172033}.pixel:nth-child(16n+8){border-right:3px solid #3157d5}.glyph-rows{max-height:400px;overflow:auto;border:1px solid var(--line);border-radius:10px}.glyph-row{display:grid;grid-template-columns:54px 100px 100px 1fr;gap:5px;padding:6px 8px;border-bottom:1px solid var(--line);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.87rem;cursor:pointer}.glyph-row.hot{background:#eef3ff}.row-focus{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.byte-big{background:#111827;color:#fff;border-radius:10px;padding:14px;text-align:center;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:1.12rem}
.io-diagram{display:grid;grid-template-columns:minmax(0,1fr) minmax(170px,210px) minmax(0,1fr);gap:22px;align-items:center}.io-side{border:2px solid #9fb0e9;border-radius:13px;padding:15px;background:#fff;text-align:center;min-width:0}.io-arrow{display:grid;place-items:center;min-height:64px;padding:10px 12px;border:1px solid #cbd7f2;border-radius:11px;background:#eef3ff;text-align:center;font-weight:900;color:#3157d5;line-height:1.25;white-space:normal}.io-arrow small{display:block;margin-top:4px;color:#526079;font-weight:800}.io-register{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:10px}.io-register div{border:1px solid var(--line);border-radius:8px;background:#f8faff;padding:8px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace}.io-register .hot{background:#ecfdf5;border-color:#86d7bd}
.bit-route{display:grid;grid-template-columns:repeat(16,1fr);gap:4px;margin:10px 0}.bit-route span{border:1px solid #aebbd8;border-radius:7px;text-align:center;padding:6px 2px;font-family:ui-monospace,SFMono-R