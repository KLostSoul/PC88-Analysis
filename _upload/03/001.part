egular,Consolas,monospace;background:#fff;font-size:.86rem}.bit-route span.used{background:#e9efff;border-color:#3157d5;font-weight:900}.slot-table{font-family:ui-monospace,SFMono-Regular,Consolas,monospace}
.coord-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.coord-col{border:1px solid var(--line);border-radius:14px;padding:14px;background:#fbfcfe}.coord-col h4{margin-top:0;color:#2444a8}.coord-item{border:1px solid #d6deec;border-radius:9px;padding:9px;margin:7px 0;background:#fff}.coord-item b{display:block;font-size:.86rem;color:#5b6578}.classify-card{border:2px solid #9fb0e9;border-radius:14px;background:#fff;padding:18px;text-align:center;font-size:1.25rem;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-weight:900;margin:14px 0}.classify-result{min-height:56px}.relationship-map{display:none}.relationship-map.visible{display:block}
.quiz details{border:1px solid var(--line);border-radius:10px;padding:10px 13px;margin:9px 0;background:#fbfcfe}.quiz summary{cursor:pointer;font-weight:800}.answer{margin-top:8px;color:#334155}footer{max-width:1080px;margin:0 auto 60px;padding:0 20px;color:var(--muted);font-size:.9rem}
.plain-sequence{max-width:760px;margin:14px auto 18px}.plain-sequence-step{padding:12px 2px;border-bottom:1px solid var(--line)}.plain-sequence-step:last-child{border-bottom:0}.plain-sequence-step b{display:block;color:#2444a8;margin-bottom:4px}.plain-sequence-step span{display:block}.plain-sequence-arrow{text-align:center;font-size:1.5rem;font-weight:900;color:#6b7ab6;line-height:1.2;padding:4px 0}

.geom-step-detail{margin:12px 0 14px;border:2px solid #9fb0e9;border-radius:13px;background:#f8faff;padding:15px 17px}.geom-step-detail h5{margin:0 0 7px;color:#2444a8;font-size:1.02rem}.geom-step-detail p{margin:.35rem 0;line-height:1.7}.plain-legend{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:12px 0}.plain-legend>div{border:1px solid #d6deec;border-radius:9px;background:#fff;padding:9px 11px}.plain-legend b{display:block;color:#2444a8}.rep-sequence{display:grid;gap:8px}.rep-row{display:flex;gap:5px;flex-wrap:wrap;align-items:center}.rep-arrow{text-align:center;color:#526079;font-weight:800}.rep-caption{margin-top:8px;color:#526079;font-size:.92rem}.mapping-example{background:#f8faff;border:1px solid #d6deec;border-radius:11px;padding:12px 14px;margin:12px 0}
@media(max-width:800px){nav.toc ol{columns:1}.grid2,.grid3,.rotation-board,.dual-rep,.glyph-editor,.coord-summary{grid-template-columns:1fr}.io-diagram{grid-template-columns:1fr}.io-arrow{transform:none;min-height:auto;margin:2px 0}.plain-legend{grid-template-columns:1fr}.svg-wrap svg{min-width:520px}.glyph-row{grid-template-columns:48px 1fr 1fr}.glyph-row span:last-child{grid-column:2/4}}
@media print{body{background:#fff}header{background:#fff;color:#000;padding:20px 0}.lead{color:#333}.wrap{padding:0}.toc,section{box-shadow:none;break-inside:avoid}button{display:none}.no-print{display:none}}

#geomControls .btn.active,#sectorControls .btn.active{background:#3157d5;color:#fff;border-color:#3157d5}
.chrn-request{border:2px solid #9fb0e9;background:#fff;border-radius:13px;padding:14px;margin:12px 0}.chrn-request-title{font-weight:900;color:#2444a8;margin-bottom:9px}.chrn-four{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.chrn-four>div{border:1px solid #cbd7f2;border-radius:10px;background:#f8faff;padding:9px;text-align:center}.chrn-four b{display:block;color:#5b6578;font-size:.82rem}.chrn-four span{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-weight:900;font-size:1.12rem}.chrn-track-label{font-weight:900;color:#334155;margin:16px 0 6px}.chrn-track{display:grid;grid-template-columns:repeat(5,minmax(110px,1fr));gap:7px;overflow:auto;margin:6px 0 14px;padding:4px}.chrn-id-card{border:2px solid #c7d1e3;background:#fff;border-radius:10px;padding:10px;text-align:center;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;white-space:nowrap}.chrn-id-card.current{border-color:#3157d5;background:#eef3ff;box-shadow:0 0 0 2px rgba(49,87,213,.10)}.chrn-id-card.passed{opacity:.42}.chrn-id-card.match{border-color:#13795b;background:#ecfdf5;color:#0f6a4f}.chrn-now{border:2px solid #3157d5;background:#eef3ff;border-radius:13px;padding:14px;margin:12px 0}.chrn-now-title{font-weight:900;color:#2444a8;margin-bottom:8px}.chrn-compare-table{width:100%;border-collapse:separate;border-spacing:0;margin:12px 0;border:1px solid var(--line);border-radius:12px;overflow:hidden}.chrn-compare-table th,.chrn-compare-table td{padding:9px 10px;border:0;border-bottom:1px solid var(--line)}.chrn-compare-table tr:last-child td{border-bottom:0}.chrn-compare-table th{background:#f3f6fb}.chrn-compare-table td:first-child{font-weight:900;color:#2444a8}.chrn-compare-table td:nth-child(2),.chrn-compare-table td:nth-child(3){font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-weight:900}.chrn-judge-ok{background:#ecfdf5;color:#0f6a4f;font-weight:900}.chrn-judge-no{background:#fff5f5;color:#a92f2f;font-weight:900}.chrn-status{border-radius:12px;padding:14px 16px;margin-top:12px;font-weight:800}.chrn-status.search{background:#fff8e6;border:1px solid #e7c56f;color:#775500}.chrn-status.found{background:#ecfdf5;border:1px solid #86d7bd;color:#0f6a4f}.chrn-status b{display:block;font-size:1.05rem;margin-bottom:4px}.process-flow{max-width:760px;margin:18px auto}.process-step{border:2px solid #b6c3e4;border-radius:13px;background:#fff;padding:14px 16px}.process-step b{display:block;color:#2444a8}.process-step span{display:block;color:#4b5870}.process-arrow{text-align:center;font-size:1.7rem;color:#6b7ab6;font-weight:900;line-height:1.1}.handshake-flow{max-width:760px;margin:18px auto;display:grid;gap:10px}.handshake-node{border:2px solid #9fb0e9;background:#f7f9ff;border-radius:13px;padding:15px;text-align:center}.handshake-node b{display:block;color:#2444a8;font-size:1.05rem}.handshake-node span{display:block}.handshake-down,.handshake-up{border-left:4px solid #3157d5;background:#eef3ff;border-radius:10px;padding:10px 14px;margin-left:28px}.handshake-down b,.handshake-up b{display:block;color:#2444a8}.handshake-down span,.handshake-up span{display:block}.handshake-down:before{content:'↓';font-size:1.5rem;font-weight:900;color:#3157d5;margin-right:8px}.handshake-up:before{content:'↑';font-size:1.5rem;font-weight:900;color:#3157d5;margin-right:8px}

@media(max-width:800px){.chrn-four{grid-template-columns:repeat(2,1fr)}.chrn-track{grid-template-columns:repeat(5,120px)}.handshake-flow{width:100%}.handshake-down,.handshake-up{margin-left:0}.svg-wrap svg{min-width:640px}.rotation-board{grid-template-columns:1fr}.seek-move{grid-template-columns:1fr}.seek-arrow{transform:rotate(90deg)}}

.plain-intro{background:#fff;border:2px solid #cbd7f2;border-radius:14px;padding:16px 18px;margin:14px 0 12px;font-size:1.02rem}.plain-intro b{color:#183c98}.term-intro{background:#eef3ff;border:1px solid #c9d8ff;border-left:5px solid #3157d5;border-radius:12px;padding:14px 16px;margin:12px 0 18px}.term-intro b{color:#183c98}.term-intro code{font-weight:800}

.geometry-visuals{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:12px 0}.geom-visual-card{border:1px solid var(--line);border-radius:14px;background:#fff;padding:12px}.geom-visual-card h5{margin:0 0 6px;color:#2444a8;font-size:1rem}.geom-visual-card svg{display:block;width:100%;height:auto;min-width:0}.geom-visual-card.side-view svg{margin-top:8px}.geom-legend{grid-template-columns:repeat(3,minmax(0,1fr))}.geom-legend>div:last-child{grid-column:auto}.track-anatomy small{display:block;margin-top:5px;font-weight:600;color:#526079;line-height:1.35}.sector-detail-6{grid-template-columns:repeat(6,minmax(130px,1fr))}.sector-detail-8{grid-template-columns:repeat(8,minmax(120px,1fr))}.pc88-chip-box{border:2px solid #3157d5;background:#f8faff;border-radius:14px;padding:15px 17px;margin:16px 0}.pc88-chip-box>b{display:block;color:#183c98;font-size:1.04rem}.pc88-chip-box p{margin:.45rem 0}.walker-assumption{border:1px solid #cbd7f2;background:#fff;border-radius:13px;padding:14px 16px;margin:14px 0}.walker-assumption>b{display:block;color:#2444a8;margin-bottom:9px}.walker-math{display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap}.walker-math span{border:1px solid var(--line);border-radius:10px;background:#f8faff;padding:10px 14px;text-align:center;min-width:150px}.walker-math>b{font-size:1.35rem;color:#3157d5}.coord-five{grid-template-columns:repeat(5,minmax(0,1fr))}
@media(max-width:900px){.coord-five{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:800px){.geometry-visuals{grid-template-columns:1fr}.geom-legend{grid-template-columns:1fr}.geom-visual-card svg{min-width:0!important}.coord-five{grid-template-columns:1fr}}

.sector-detail-6{grid-template-columns:repeat(6,minmax(0,1fr));overflow:visible}.sector-detail-8{grid-template-columns:repeat(8,minmax(0,1fr));overflow:visible}@media(max-width:800px){.sector-detail-6,.sector-detail-8{grid-template-columns:repeat(2,minmax(0,1fr));overflow:visible}}

#chrn .fixed-head-marker:before{content:none}
.mapping-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:14px 0 18px}.mapping-rule-card{border:1px solid #cbd7f2;border-radius:12px;background:#f8faff;padding:13px 15px}.mapping-rule-card>b{display:block;color:#2444a8;margin-bottom:8px}.mapping-rule-card code{display:block;white-space:normal;overflow-wrap:anywhere;line-height:1.6}.slot-table table{max-width:520px;margin-left:auto;margin-right:auto}
@media(max-width:800px){
.rotation-board .svg-wrap svg{min-width:0!important}
.seek-axis{overflow:visible!important}.seek-track-row{grid-template-columns:repeat(2,minmax(0,1fr));min-width:0}.seek-track-box{min-width:0}.seek-axis-title{font-size:.9rem}
.mapping-cards{grid-template-columns:1fr}.bit-route{grid-template-columns:repeat(8,minmax(30px,1fr));gap:5px}.bit-route span{font-size:.82rem;padding:6px 1px}
}
</style>
</head>
<body>
<header><div class="header-inner"><div class="eyebrow">PC-88 GAME ANALYSIS BASICS</div><h1>PC-88 게임 분석을 위한 기초 강좌 3부</h1><p class="lead">플로피 안에서 데이터가 어떻게 지나가고 읽히는지부터 시작해, 그 데이터가 디스크 이미지 파일과 메모리에서 어떻게 다른 위치값으로 보이는지, 그리고 글자 모양 데이터를 어떻게 찾아 화면에 그리는지 순서대로 배웁니다. 전문용어는 동작을 먼저 이해한 뒤 하나씩 붙입니다.</p><div class="hero-badges"><span class="hero-badge">플로피가 읽히는 원리</span><span class="hero-badge">디스크 데이터를 찾는 과정</span><span class="hero-badge">D88 파일 구조</span><span class="hero-badge">글자 모양 데이터</span><span class="hero-badge">필요한 실습만</span></div></div></header>
<div class="wrap">
<nav class="toc"><strong>목차</strong><ol>
<li><a href="#map">전체 흐름부터 보기</a></li><li><a href="#rotation">1. 무엇이 회전하는가</a></li><li><a href="#seek">2. 다른 기록 줄로 이동하는 방법</a></li><li><a href="#geometry">3. 디스크의 양쪽 면 읽기</a></li><li><a href="#sector">4. 한 기록 구간의 구조</a></li><li><a href="#chrn">5. 원하는 구간을 찾는 네 값</a></li><li><a href="#size">6. 데이터 크기를 나타내는 코드</a></li><li><a href="#media">7. 디스크 종류와 실제 배치</a></li><li><a href="#fdc">8. FDC와 μPD765가 데이터를 읽는 과정</a></li><li><a href="#subcpu">9. PC-88에서 디스크 일을 나누는 구조</a></li><li><a href="#handshake">10. 두 CPU가 일을 주고받는 방법</a></li><li><a href="#d88">11. 실제 플로피를 파일로 보관하는 방법</a></li><li><a href="#d88-map">12. 파일 속 Track 위치표</a></li><li><a href="#sector-header">13. 데이터 앞의 16바이트 설명 정보</a></li><li><a href="#walker">14. 다음 Sector 위치 찾기</a></li><li><a href="#raw">15. 데이터만 있는 표현과 metadata가 있는 표현</a></li><li><a href="#disk-ram">16. 파일 위치와 메모리 위치</a></li><li><a href="#kanji">17. 글자 모양 데이터는 어디에 있는가</a></li><li><a href="#glyph">18. 16×16 점 그림과 32바이트</a></li><li><a href="#jis">19. 게임 내부 문자값과 JIS 구분</a></li><li><a href="#jis-mapping">20. JIS를 Kanji ROM 위치값으로 바꾸기</a></li><li><a href="#kanji-io">21. KANJI access로 실제 글자 모양 읽기</a></li><li><a href="#rom-offset">22. 하드웨어 위치값과 ROM 파일 위치</a></li><li><a href="#custom-font">23. 내장 글꼴과 게임 자체 글꼴</a></li><li><a href="#coordinates">24. 다섯 가지 위치 체계 정리</a></li><li><a href="#final-lab">25. 숫자가 어느 단계의 값인지 분류</a></li><li><a href="#quiz">확인 문제</a></li>
</ol></nav>
<secti